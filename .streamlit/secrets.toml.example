# Template for your Streamlit secrets. This file is safe to commit: it has no real key.
#
# To use it:
#   1. Copy this file to .streamlit/secrets.toml (that file is gitignored)
#   2. Replace the placeholder with your Gemini API key from https://aistudio.google.com/apikey
#
# The app reads the key with:  st.secrets["GEMINI_API_KEY"]

GEMINI_API_KEY = "paste-your-key-here"
